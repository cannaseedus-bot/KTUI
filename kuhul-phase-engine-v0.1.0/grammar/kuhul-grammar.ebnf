(* K'UHUL core source grammar v0.2; declarative, not an execution grant. *)
program         = { statement } ;
statement       = declaration | instruction | phase_block | lane_block | binding | relation_decl ;
declaration     = "glyph", identifier, "=", string ;
instruction     = opcode, "(", [ argument_list ], ")" ;
opcode          = "map" | "filter" | "fold" | "reduce" | "sync" | "emit" | "verify" | "dispatch" ;
phase_block     = phase, "{", { statement }, "}" ;
phase           = "Pop" | "Wo" | "Yax" | "Sek" | "Chen" | "Xul" ;
lane_block      = "lane", identifier, ":", type, "{", { statement }, "}" ;
binding         = "bind", reference, "->", reference ;
relation_decl   = "relation", identifier, "=", string ;
type            = "Glyph" | "Vector" | "Field" | "Tensor" | "Graph" | "Scalar" | "Memory" | "Program" ;
argument_list   = value, { ",", value } ;
value           = reference | number | string ;
reference       = identifier | glyph_reference ;
glyph_reference = "⟁", identifier, { "-", identifier } ;
identifier      = letter, { letter | digit | "_" } ;
number          = digit, { digit } ;
string          = '"', { character }, '"' ;
letter          = "A".."Z" | "a".."z" ;
digit           = "0".."9" ;
character       = ? any Unicode character except unescaped double quote or line break ? ;
(* Whitespace/comments are handled by the lexer; relation_decl is an extension. *)
