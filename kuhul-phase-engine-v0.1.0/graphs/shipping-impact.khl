[Pop enterprise_shipping_impact]
  [Wo graph = "asx://enterprise/demo/1"]
  [Wo scenario = "shock_15pct"]
  [Yax resolve "risk_shipping"]
  [Yax traverse "affects|contributes_to_cost|used_in|sold_in"]
  [Sek FILTER "affected_products"]
  [Sek MAP "shipping_delta_per_product"]
  [Sek FOLD "market_exposure"]
  [Sek ACCUMULATE "scenario_impacts"]
  [Sek REDUCE "total_exposure"]
  [Ch'en verify "provenance,units,coverage,permissions"]
  [Xul emit "read_only_analysis_proposal"]
[Xul]
