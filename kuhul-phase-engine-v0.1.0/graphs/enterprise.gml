graph [
  schema "asx-enterprise-graph/1"
  graph_id "asx://enterprise/demo/1"
  authority "declaration_only"
  description "Illustrative multi-domain enterprise dependency graph"

  node [ id "enterprise" kind "enterprise" label "Example Corporation" ]
  node [ id "finance" kind "department" label "Finance" ]
  node [ id "operations" kind "department" label "Operations" ]
  node [ id "sales" kind "department" label "Sales" ]
  node [ id "compliance" kind "department" label "Compliance" ]
  node [ id "procurement" kind "department" label "Procurement" ]
  node [ id "supplier_asia" kind "supplier" label "Asia Logistics Supplier" region "APAC" ]
  node [ id "shipping_apac" kind "cost_driver" label "APAC Shipping Cost" unit "USD_per_unit" ]
  node [ id "component_a" kind "component" label "Component A" ]
  node [ id "product_a" kind "product" label "Product A" ]
  node [ id "product_b" kind "product" label "Product B" ]
  node [ id "market_us" kind "market" label "United States" ]
  node [ id "market_eu" kind "market" label "European Union" ]
  node [ id "customer_retail" kind "customer_segment" label "Retail Customers" ]
  node [ id "margin_a_us" kind "metric" label "Product A US Margin" ]
  node [ id "margin_b_eu" kind "metric" label "Product B EU Margin" ]
  node [ id "risk_shipping" kind "risk" label "Shipping Cost Shock" ]
  node [ id "policy_eu" kind "regulation" label "EU Import Compliance" ]

  edge [ source "enterprise" target "finance" relation "has_department" ]
  edge [ source "enterprise" target "operations" relation "has_department" ]
  edge [ source "enterprise" target "sales" relation "has_department" ]
  edge [ source "enterprise" target "compliance" relation "has_department" ]
  edge [ source "enterprise" target "procurement" relation "has_department" ]
  edge [ source "procurement" target "supplier_asia" relation "manages_supplier" ]
  edge [ source "supplier_asia" target "component_a" relation "supplies" ]
  edge [ source "shipping_apac" target "component_a" relation "contributes_to_cost" ]
  edge [ source "component_a" target "product_a" relation "used_in" ]
  edge [ source "component_a" target "product_b" relation "used_in" ]
  edge [ source "product_a" target "market_us" relation "sold_in" ]
  edge [ source "product_b" target "market_eu" relation "sold_in" ]
  edge [ source "market_us" target "customer_retail" relation "serves_segment" ]
  edge [ source "market_eu" target "customer_retail" relation "serves_segment" ]
  edge [ source "product_a" target "margin_a_us" relation "measured_by" ]
  edge [ source "product_b" target "margin_b_eu" relation "measured_by" ]
  edge [ source "risk_shipping" target "shipping_apac" relation "affects" ]
  edge [ source "policy_eu" target "market_eu" relation "governs" ]
  edge [ source "finance" target "margin_a_us" relation "monitors" ]
  edge [ source "finance" target "margin_b_eu" relation "monitors" ]
  edge [ source "compliance" target "policy_eu" relation "monitors" ]
]
