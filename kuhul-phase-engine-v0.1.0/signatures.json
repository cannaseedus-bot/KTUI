{
  "schema": "kuhul.host-gate.signatures/2",
  "signatures": [
    {
      "id": "F14-schema-mismatch",
      "ledger": "F14",
      "error_pattern": "schema mismatch",
      "traceback_pattern": "extension.py|registry.py|assemble.py",
      "guard_test_pattern": "test_.*(foreign|schema|ownership|boundary)"
    },
    {
      "id": "F14-wrong-contract",
      "ledger": "F14",
      "error_pattern": "wrong (?:schema|contract)|reference schema mismatch|document has no schema",
      "traceback_pattern": "resolver|bundle|extension",
      "guard_test_pattern": "test_.*(cross_schema|reference|no_schema|malformed)"
    },
    {
      "id": "M2-unknown-field",
      "ledger": "M2",
      "error_pattern": "unknown field|unregistered field",
      "traceback_pattern": "registry.py|extension.py",
      "guard_test_pattern": "test_.*(typo|unknown_field|unregistered|scope)"
    },
    {
      "id": "M2-repeatability",
      "ledger": "M2",
      "error_pattern": "duplicate|required once",
      "traceback_pattern": "registry.py",
      "guard_test_pattern": "test_.*(repeat|duplicate|value)"
    }
  ]
}
