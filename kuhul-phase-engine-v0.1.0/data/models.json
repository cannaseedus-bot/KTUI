{
  "schema": "kuhul-model-router/v1",
  "authority": "declaration_only",
  "models": {
    "advisor": {
      "base_url": "http://127.0.0.1:9032/v1",
      "role": "complex_reasoning",
      "preference": "deep",
      "features": [
        "chat",
        "tools"
      ],
      "state": "cold",
      "idle_timeout_seconds": 300,
      "launch": {
        "alias": "gpt-oss-20b",
        "port": 9032
      }
    },
    "worker": {
      "base_url": "http://127.0.0.1:9040/v1",
      "role": "fast_inference",
      "preference": "fast",
      "features": [
        "chat",
        "code"
      ],
      "state": "hot",
      "idle_timeout_seconds": 900,
      "launch": {
        "alias": "gemma-3-1b",
        "port": 9040
      }
    },
    "planner": {
      "base_url": "http://127.0.0.1:9041/v1",
      "role": "structured_planning",
      "preference": "plan",
      "features": [
        "chat",
        "code",
        "json"
      ],
      "state": "cold",
      "idle_timeout_seconds": 600,
      "launch": {
        "alias": "qwen3-1.7b-q4",
        "port": 9041,
        "no_think": true
      }
    }
  },
  "routing": {
    "micronaut://v1/aiml": "worker",
    "micronaut://v1/eliza": "worker",
    "micronaut://v1/relations": "planner",
    "micronaut://v1/memory": "worker",
    "micronaut://v1/compose": "planner"
  },
  "preferences": {
    "fast": [
      "worker",
      "advisor"
    ],
    "deep": [
      "advisor",
      "worker"
    ],
    "cheap": [
      "worker",
      "advisor"
    ],
    "plan": [
      "planner",
      "advisor",
      "worker"
    ]
  },
  "policy": {
    "probe": "/models",
    "timeout_seconds": 2,
    "require_registered": true,
    "note": "only endpoints declared here are probed; a port that merely responds is not a model. planner runs qwen3-1.7b with thinking disabled (--reasoning-budget 0)",
    "lifecycle": "hot: listening; cold: not listening (warm is unsupported by this runtime). Only a registered launch can wake a model, and only an owned, unleased process sleeps."
  }
}
