graph [
  schema "gml-registry/1"
  graph_id "registry/gml-tensor"
  extension [ schema_id "gml-tensor/1" owner "gml.tensor" ]
  resolver [ scheme "gml" kind "whole_graph" ]
  contract [ name "tensor_source" required "graph_id" required "tensor" ]
  contract [ name "tensor_assembly" required "graph_id" required "tensor" required "slice" ]
  field [ path "tensor" name "rank" type "integer" required_value 2 required 1 ]
  field [ path "tensor" name "shape" type "block" required 1 required_fields "rows,cols" ]
  field [ path "tensor.shape" name "rows" type "positive_integer" required 1 ]
  field [ path "tensor.shape" name "cols" type "positive_integer" required 1 ]
  field [ path "tensor" name "dtype" type "enum" values "float32,float64" required 1 ]
  field [ path "tensor" name "layout" type "enum" values "row_major" required 1 ]
  field [ path "slice" name "source_ref" type "graph_uri" required 1 ]
  field [ path "slice" name "row_offset" type "nonnegative_integer" required 1 ]
  field [ path "slice" name "col_offset" type "nonnegative_integer" required 1 ]
  field [ path "graph" name "schema" type "enum" values "gml-tensor/1" required 1 ]
  field [ path "graph" name "graph_id" type "string" required 1 ]
  field [ path "graph" name "contract" type "enum" values "tensor_source,tensor_assembly" required 1 ]
  field [ path "graph" name "directed" type "integer" ]
  field [ path "graph" name "tensor" type "block" required 1 ]
  field [ path "graph" name "data" type "block" ]
  field [ path "graph" name "slice" type "block" ]
  field [ path "graph" name "coverage_policy" type "enum" values "complete,sparse" ]
  field [ path "graph" name "overlap_policy" type "enum" values "reject" ]
  field [ path "data" name "value" type "number" repeatable 1 ]
  constraint [ name "data_count" arity 2 scope "source" predicate "data_count" authority "declaration_only" ]
  constraint [ name "finite_values" arity 1 scope "source" predicate "finite_values" authority "declaration_only" ]
  constraint [ name "dtype_match" arity 3 scope "assembly" predicate "dtype_match" authority "declaration_only" ]
  constraint [ name "bounds_check" arity 4 scope "assembly" predicate "bounds_check" authority "declaration_only" ]
  constraint [ name "no_overlap" arity 2 scope "assembly" predicate "no_overlap" authority "declaration_only" ]
  constraint [ name "complete_coverage" arity 3 scope "assembly" predicate "complete_coverage" authority "declaration_only" ]
  operator [ name "ASSEMBLE" signature "slices,shape -> tensor_plan" authority "declaration_only" ]
]
