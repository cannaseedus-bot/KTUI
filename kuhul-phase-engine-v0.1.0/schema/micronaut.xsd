<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:simpleType name="Identifier"><xs:restriction base="xs:string"><xs:pattern value="[A-Za-z_][A-Za-z0-9_.-]*"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="PhaseName"><xs:restriction base="xs:string"><xs:enumeration value="Pop"/><xs:enumeration value="Wo"/><xs:enumeration value="Yax"/><xs:enumeration value="Sek"/><xs:enumeration value="Chen"/><xs:enumeration value="Xul"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="OpName"><xs:restriction base="xs:string"><xs:enumeration value="READ"/><xs:enumeration value="BIND"/><xs:enumeration value="MAP"/><xs:enumeration value="FILTER"/><xs:enumeration value="PI"/><xs:enumeration value="MATCH"/><xs:enumeration value="RESOLVE"/><xs:enumeration value="SRAI"/><xs:enumeration value="RANK"/><xs:enumeration value="XCFE"/><xs:enumeration value="ACCUMULATE"/><xs:enumeration value="FOLD"/><xs:enumeration value="REDUCE"/><xs:enumeration value="ASK"/><xs:enumeration value="RESPOND"/><xs:enumeration value="PATCH"/><xs:enumeration value="CLOSE"/></xs:restriction></xs:simpleType>
  <xs:element name="micronaut"><xs:complexType><xs:sequence>
    <xs:element name="role" type="xs:string"/><xs:element name="graph" type="xs:string"/><xs:element name="data" type="xs:string" minOccurs="0"/>
    <xs:element name="pattern" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:attribute name="match" type="xs:string" use="required"/><xs:attribute name="action" use="required"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="srai"/><xs:enumeration value="intent"/></xs:restriction></xs:simpleType></xs:attribute><xs:attribute name="target" type="Identifier" use="required"/></xs:complexType></xs:element>
    <xs:element name="capability" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:attribute name="name" type="Identifier" use="required"/><xs:attribute name="kind" type="xs:string" use="required"/></xs:complexType></xs:element>
    <xs:element name="binding" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:attribute name="name" type="Identifier" use="required"/><xs:attribute name="type" type="xs:string" use="required"/><xs:attribute name="source" type="Identifier" use="required"/></xs:complexType></xs:element>
    <xs:element name="route" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:attribute name="from" type="Identifier" use="required"/><xs:attribute name="to" type="Identifier" use="required"/></xs:complexType></xs:element>
    <xs:element name="gate"><xs:complexType><xs:attribute name="admission" type="xs:boolean" use="required"/><xs:attribute name="verification" type="xs:boolean" use="required"/><xs:attribute name="closure" type="xs:boolean" use="required"/></xs:complexType></xs:element>
    <xs:element name="phase" minOccurs="1" maxOccurs="6"><xs:complexType><xs:sequence><xs:element name="step" minOccurs="0" maxOccurs="unbounded"><xs:complexType><xs:attribute name="op" type="OpName" use="required"/><xs:attribute name="in" type="Identifier"/><xs:attribute name="out" type="Identifier"/></xs:complexType></xs:element></xs:sequence><xs:attribute name="name" type="PhaseName" use="required"/></xs:complexType></xs:element>
  </xs:sequence><xs:attribute name="id" type="Identifier" use="required"/><xs:attribute name="format" type="xs:string" use="required"/></xs:complexType></xs:element>
</xs:schema>
