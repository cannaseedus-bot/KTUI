{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kuhul.dev/schema/micronaut.v1.schema.json",
  "title": "K'UHUL Micronaut Declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "role",
    "graph",
    "gate",
    "phases"
  ],
  "properties": {
    "format": {
      "const": "kuhul.micronaut/1"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "graph": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "string",
      "minLength": 1
    },
    "patterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pattern"
      },
      "default": []
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      },
      "default": []
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      },
      "default": []
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      },
      "default": []
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission",
        "verification",
        "closure"
      ],
      "properties": {
        "admission": {
          "type": "boolean"
        },
        "verification": {
          "type": "boolean"
        },
        "closure": {
          "type": "boolean"
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/phase"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "type": {
      "enum": [
        "string",
        "vector",
        "tensor",
        "field",
        "signal",
        "graph",
        "number",
        "boolean"
      ]
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match",
        "action",
        "target"
      ],
      "properties": {
        "match": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "srai",
            "intent"
          ]
        },
        "target": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "read",
            "write",
            "ask",
            "respond",
            "compute"
          ]
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "source"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "$ref": "#/$defs/type"
        },
        "source": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/identifier"
        },
        "to": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "steps"
      ],
      "properties": {
        "name": {
          "enum": [
            "Pop",
            "Wo",
            "Yax",
            "Sek",
            "Ch'en",
            "Xul"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "enum": [
            "READ",
            "BIND",
            "MAP",
            "FILTER",
            "PI",
            "MATCH",
            "RESOLVE",
            "SRAI",
            "RANK",
            "XCFE",
            "ACCUMULATE",
            "FOLD",
            "REDUCE",
            "ASK",
            "RESPOND",
            "PATCH",
            "CLOSE"
          ]
        },
        "in": {
          "$ref": "#/$defs/identifier"
        },
        "out": {
          "$ref": "#/$defs/identifier"
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "condition": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "operator",
        "right"
      ],
      "properties": {
        "left": {
          "$ref": "#/$defs/identifier"
        },
        "operator": {
          "enum": [
            "eq",
            "ne",
            "contains",
            "exists",
            "gt",
            "ge",
            "lt",
            "le"
          ]
        },
        "right": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}
