# This checkout is LF on disk (the AIML corpus ships LF), and this machine's system gitconfig sets
# core.autocrlf=true. Pin the worktree to LF so a `git restore` / `git checkout` returns the exact
# bytes that were committed instead of rewriting every line ending to CRLF.
* text=auto eol=lf

# cmd.exe wants batch files with CRLF: GOTO and labels misbehave when the script is LF-only.
*.bat text eol=crlf

# The K'UHUL package ships byte-for-byte with SHA-256 digests in its manifest. Normalising its line
# endings would silently invalidate every digest, so keep its bytes exactly as delivered.
kuhul-phase-engine-v0.1.0/** -text
