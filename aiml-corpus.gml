 node [ id 823 kind "category" bank 1 phrase "WHAT IS A BEAR" wildcard_count 0 template_kind "text" template "A bear is a large furry animal with lots of muscles, teeth, and claws whom you should not irritate. They are especially jealous of their food, their sleep, and their young. bear" ]
