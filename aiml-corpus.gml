 constraint [ name "one_node_per_category" arity 1 scope "graph" predicate "category_count_matches" authority "declaration_only" ]
 constraint [ name "no_grant_from_corpus" arity 1 scope "graph" predicate "corpus_grants_nothing" authority "declaration_only" ]
 operator [ name "LOOKUP" signature "phrase -> category*" authority "declaration_only" ]
 note "A projection for inspection and verification. It grants no execution: the kernel still loads the .aiml files, and admission is still the host's."
]
