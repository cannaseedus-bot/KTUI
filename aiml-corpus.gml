graph [
 schema "gml-registry/1"
 graph_id "corpus/aiml"
 extension [ schema_id "gml-aiml-corpus/1" owner "knumatic.host" ]
 contract [ name "aiml-corpus" required "bank" required "category" ]
 note "Projection of the AIML corpus: one bank node per file, one category node per <category>, one edge per containment and per resolved <srai>."
 note "Digests are sha256 of the source file, so this document can be re-verified against the corpus it claims to describe."

